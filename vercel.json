{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/analyze.js": { "maxDuration": 60 },
    "api/edition.js": { "maxDuration": 300, "includeFiles": "public/edition.json" }
  },
  "headers": [
    { "source": "/edition.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
